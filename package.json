{
  "name": "heic-anyconv",
  "version": "0.1.0-beta.1",
  "description": "Universal HEIC/HEIF to any format converter. Supports JPEG, PNG, WebP, AVIF, TIFF. Works in Node.js and browsers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": {
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.cjs"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    }
  },
  "browser": "./dist/browser/index.js",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "heic",
    "heif",
    "convert",
    "image",
    "jpeg",
    "png",
    "webp",
    "avif",
    "tiff",
    "iphone",
    "photo",
    "wasm"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "libheif-js": "^1.19.8",
    "upng-js": "^2.1.0"
  }
}
