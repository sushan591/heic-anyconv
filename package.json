{
  "name": "heic-anyconv",
  "version": "0.2.0",
  "description": "Lightweight browser HEIC/HEIF to JPEG, PNG, WebP converter. Single dependency, Canvas-based encoding.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "heic",
    "heif",
    "convert",
    "image",
    "jpeg",
    "png",
    "webp",
    "browser",
    "iphone",
    "photo",
    "wasm",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "sideEffects": false,
  "dependencies": {
    "libheif-js": "^1.19.8"
  }
}
